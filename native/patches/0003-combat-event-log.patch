 }
 
 void MonsterGroup::createMonster(BattleContext &bc, MonsterId id) {
+    bc.recordCombatEvent(BattleContext::EVENT_SPAWNED, monsterCount, int(id));
     arr[monsterCount].construct(bc, id, monsterCount);
     ++monsterCount;
     ++monstersAlive;
@@ -576,6 +577,8 @@ void MonsterGroup::doMonsterTurn(BattleContext &bc) {
         if (skipTurn[bc.monsterTurnIdx]) {
             skipTurn.set(bc.monsterTurnIdx, false);
         } else {
+            // record the move that is actually about to execute, for observability
+            bc.recordCombatEvent(BattleContext::EVENT_EXECUTED, bc.monsterTurnIdx, int(m.moveHistory[0]));
             m.takeTurn(bc);
         }
     }
