diff --git a/include/combat/BattleContext.h b/include/combat/BattleContext.h
index 767bbcd..f2b69da 100644
--- a/include/combat/BattleContext.h
+++ b/include/combat/BattleContext.h
@@ -70,6 +70,20 @@ namespace sts {
         InputState inputState = InputState::EXECUTING_ACTIONS;
         CardSelectInfo cardSelectInfo;
 
+        // OBSERVABILITY-ONLY event log. No rule reads it; it exists so an adapter
+        // can know what actually executed and what actually spawned instead of
+        // inferring it from the turn counter. Reset and copied like any state.
+        struct CombatEvent { std::int8_t kind; std::int8_t slot; std::int16_t move; };
+        static constexpr std::int8_t EVENT_EXECUTED = 0;
+        static constexpr std::int8_t EVENT_SPAWNED = 1;
+        static constexpr int EVENT_CAPACITY = 512;
+        std::array<CombatEvent, EVENT_CAPACITY> combatEvents{};
+        int combatEventCount = 0;
+        void recordCombatEvent(std::int8_t kind, int slot, int move) {
+            if (combatEventCount < EVENT_CAPACITY)
+                combatEvents[combatEventCount++] = CombatEvent{kind, std::int8_t(slot), std::int16_t(move)};
+        }
+
         int monsterTurnIdx = 6;
 
         bool isBattleOver = false;
